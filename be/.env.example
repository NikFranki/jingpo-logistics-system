DATABASE_URL=postgresql+psycopg:///jingpo_logistics
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SCHEDULE_SIGNING_KEY=replace-with-a-random-secret
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false

# Email provider: smtp (default) or gmail_api
EMAIL_PROVIDER=smtp

# Local Mailpit defaults
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@jingpo.local

# Gmail SMTP: select EMAIL_PROVIDER=smtp and replace the values above
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your-address@gmail.com

# Gmail API: set EMAIL_PROVIDER=gmail_api and use a refresh token authorized
# with https://www.googleapis.com/auth/gmail.send. Sender must be that Gmail.
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
