DATABASE_URL=postgresql+psycopg:///jingpo_logistics
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SCHEDULE_SIGNING_KEY=replace-with-a-random-secret
AUTH_FRONTEND_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false

# Local Mailpit defaults
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@jingpo.local

# Gmail SMTP: replace the values above to deliver to real inboxes
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_SSL=false
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=your-address@gmail.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
