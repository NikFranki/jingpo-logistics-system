# Copy to .env only on first setup. Replace both placeholders before running.
# Switch providers by changing LLM_PROVIDER. Set the matching API key below.
# LLM_PROVIDER=deepseek|qwen
LLM_PROVIDER=qwen
# LLM_MODEL=deepseek-flash|qwen3.8-max
LLM_MODEL=qwen3.8-max
DEEPSEEK_API_KEY=your-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
# Qwen Beijing default: https://dashscope.aliyuncs.com/compatible-mode/v1
# Leave unset to use the provider default, or set a workspace-specific endpoint.
# LLM_BASE_URL=https://api.deepseek.com|https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BE_BASE_URL=http://127.0.0.1:8000

# Optional redacted diagnostics to stderr
AGENT_DEBUG=false
